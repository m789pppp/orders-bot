# Put these in Vercel: Project > Settings > Environment Variables. Never share them.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Meta WhatsApp (WhatsApp > API Setup, and App settings > Basic)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=

# AI (free Gemini key from aistudio.google.com)
AI_API_KEY=
# Optional: switch to OpenAI by setting these two
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4.1-mini

# Dashboard admin: the email of the Supabase user, and the phone used to log in
ADMIN_EMAILS=
ADMIN_PHONE=

# Business
BUSINESS_NAME=

# Optional: Telegram alerts for new orders
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=
